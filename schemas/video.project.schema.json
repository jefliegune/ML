{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/code-driven-video/video.project.schema.json",
  "title": "Code-driven video project",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "root", "entry", "composition", "output"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "root": {
      "type": "string",
      "description": "Project root relative to the repository root."
    },
    "entry": {
      "type": "string",
      "description": "Remotion entry file relative to root."
    },
    "composition": {
      "type": "string"
    },
    "timeline": {
      "type": "string",
      "description": "Generated timeline JSON relative to root."
    },
    "timelineTypes": {
      "type": "string",
      "description": "Generated timeline TypeScript file relative to root."
    },
    "output": {
      "type": "string",
      "description": "Pre-master MP4 under local/out/ or out/."
    },
    "master": {
      "type": "string",
      "description": "Mastered MP4 under local/out/ or out/."
    },
    "cover": {
      "type": "object",
      "description": "3:4 cover rendered after video QC. The cover composition must be 1080x1440.",
      "additionalProperties": false,
      "required": ["composition"],
      "properties": {
        "composition": {
          "type": "string",
          "description": "Registered 3:4 Remotion Still composition ID (1080x1440)."
        },
        "output": {
          "type": "string",
          "description": "PNG under local/out/ or out/. Defaults to <output>-cover-3x4.png."
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "durationInFrames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "durationInFrames": { "type": "integer", "minimum": 1 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetLufs": { "type": "number", "minimum": -24, "maximum": -10 }
      }
    },
    "render": {
      "type": "object",
      "description": "Delivery render settings. These are never used for draft previews.",
      "additionalProperties": false,
      "properties": {
        "codec": { "type": "string" },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51,
          "description": "Delivery default is 14. Motion graphics usually look best from 14 to 16."
        },
        "pixelFormat": { "type": "string" },
        "audioCodec": { "type": "string" },
        "audioBitrate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?k$"
        },
        "concurrency": { "type": "integer", "minimum": 1 },
        "imageFormat": {
          "type": "string",
          "enum": ["jpeg", "png"],
          "description": "Intermediate frame format. PNG sharpens fine lines but costs substantially more render time and disk."
        },
        "jpegQuality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "x264Preset": {
          "type": "string",
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow",
            "placebo"
          ]
        },
        "colorSpace": {
          "type": "string",
          "enum": [
            "bt601",
            "bt709",
            "bt2020-ncl",
            "bt2020-cl",
            "fcc",
            "bt470bg",
            "smpte170m",
            "smpte240m",
            "ycgco",
            "smpte2085",
            "chroma-derived-ncl",
            "chroma-derived-cl",
            "ictcp"
          ],
          "description": "Delivery defaults to bt709 with limited range so the encoded stream is standard yuv420p."
        }
      }
    },
    "preview": {
      "type": "object",
      "description": "Draft settings used only by preview-section.",
      "additionalProperties": false,
      "properties": {
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "audioBitrate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?k$"
        },
        "concurrency": { "type": "integer", "minimum": 1 },
        "imageFormat": {
          "type": "string",
          "enum": ["jpeg", "png"]
        },
        "jpegQuality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
