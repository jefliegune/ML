{
  "name": "code-driven-video-system",
  "version": "1.0.0",
  "description": "A code-driven video production system built with Remotion, React and TypeScript, including reusable motion design, asset management, mastering and QC.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@remotion/captions": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/eslint-config-flat": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run lint && npm run pack:check && npm run check:boundaries && npm run library:check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:timeline": "node scripts/check-timeline.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "voice": "node scripts/generate-voiceover.mjs",
    "library:import": "node scripts/import-reference-libraries.mjs",
    "library:huashu": "node scripts/import-huashu-library.mjs",
    "library:check": "node scripts/check-huashu-library.mjs",
    "assets": "node studio/server.mjs",
    "render:packaging": "remotion render PackagingSystem local/out/packaging-system.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "master:packaging": "node scripts/master-video.mjs local/out/packaging-system.mp4 local/out/packaging-system-final.mp4 -16",
    "verify:packaging": "node scripts/verify-video.mjs local/out/packaging-system-final.mp4",
    "pipeline:packaging": "node scripts/pipeline.mjs --project packaging-system",
    "render:stylelab": "remotion render StyleLab local/out/stylelab.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "master:stylelab": "node scripts/master-video.mjs local/out/stylelab.mp4 local/out/stylelab-final.mp4 -16",
    "verify:stylelab": "node scripts/verify-video.mjs local/out/stylelab-final.mp4",
    "pipeline:stylelab": "node scripts/pipeline.mjs --project stylelab",
    "pipeline:pixel-arcade": "node scripts/pipeline.mjs --project pixel-arcade",
    "preview:shots": "node scripts/preview-shots.mjs",
    "preview:section": "node scripts/preview-section.mjs",
    "cover": "node scripts/render-cover.mjs",
    "check:composition": "node scripts/check-composition.mjs",
    "pipeline": "node scripts/pipeline.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
