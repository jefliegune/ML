{
  "name": "code-driven-video-system",
  "version": "1.0.0",
  "description": "A code-driven video production system built with Remotion, React and TypeScript, including reusable motion design, asset management, mastering and QC.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@remotion/captions": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "node scripts/generate-audio.mjs",
    "library:import": "node scripts/import-reference-libraries.mjs",
    "assets": "node studio/server.mjs",
    "render:packaging": "remotion render PackagingSystem local/out/packaging-system.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "master:packaging": "node scripts/master-video.mjs local/out/packaging-system.mp4 local/out/packaging-system-final.mp4 -16",
    "verify:packaging": "node scripts/verify-video.mjs local/out/packaging-system-final.mp4",
    "render:stylelab": "remotion render StyleLab local/out/stylelab.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "master:stylelab": "node scripts/master-video.mjs local/out/stylelab.mp4 local/out/stylelab-final.mp4 -16"
  },
  "allowScripts": {
    "esbuild": false
  }
}
