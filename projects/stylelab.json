{
  "$schema": "../schemas/video.project.schema.json",
  "id": "stylelab",
  "root": ".",
  "entry": "src/index.ts",
  "composition": "StyleLab",
  "output": "local/out/stylelab.mp4",
  "master": "local/out/stylelab-final.mp4",
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "durationInFrames": 300
  },
  "audio": {
    "targetLufs": -16
  },
  "render": {
    "codec": "h264",
    "crf": 14,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "320k",
    "concurrency": 8,
    "imageFormat": "jpeg",
    "jpegQuality": 95,
    "x264Preset": "medium",
    "colorSpace": "bt709"
  }
}
