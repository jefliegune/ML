  "grammars": [
    {
      "id": "t1-3b1b",
      "name": "3Blue1Brown 式数学／概念可视化",
      "oneLiner": "黑底上只放「正在讲的那一个东西」，用平滑形变（Transform）把上一个概念直接变成下一个，颜色＝概念的名字，全片几乎不切。",
      "card": "docs/reference/huashu/动画语法/t1_3b1b.md",
      "source": "huashu-art-motion/references/动画语法/t1_3b1b.md"
    },
    {
      "id": "t2-keynote-ui",
      "name": "发布会式界面与渐变动效",
      "oneLiner": "一屏一件事，产品本身（截图、录屏、实物）当主角，名词和数字在口播说到时落定；字收紧，弹簧无回弹或轻回弹。",
      "card": "docs/reference/huashu/动画语法/t2_keynote_ui.md",
      "source": "huashu-art-motion/references/动画语法/t2_keynote_ui.md"
    },
    {
      "id": "t3-finance-chart",
      "name": "财经数据图表动画",
      "oneLiner": "先搭坐标系、再让数据「长」出来、最后只标一件事；一个颜色讲主角、其余变灰；数值永远诚实（柱从 0 起、单位和来源写在图上），动画只决定「怎么出现」，不改变「是多少」。",
      "card": "docs/reference/huashu/动画语法/t3_finance_chart.md",
      "source": "huashu-art-motion/references/动画语法/t3_finance_chart.md"
    },
    {
      "id": "y1",
      "name": "Kurzgesagt 扁平科普",
      "oneLiner": "把一个抽象概念画成一个具体的物，放进能无限缩放的发光世界里，相机在尺度之间穿行；环境层（星、粒子）可以一直轻轻动，主体和信息在口播节点上发生变化，落定后停住。",
      "card": "docs/reference/huashu/动画语法/y1_kurzgesagt.md",
      "source": "huashu-art-motion/references/动画语法/y1_kurzgesagt.md"
    },
    {
      "id": "y2",
      "name": "Vox 式拼贴解说",
      "oneLiner": "把论证摆在一张有真实材料的桌面上——剪报、照片、文件，相机像调查记者的眼睛在桌上移动；线和笔一顿一顿地画上去，证据感来自「这些东西是真的被放在这里的」。",
      "card": "docs/reference/huashu/动画语法/y2_vox.md",
      "source": "huashu-art-motion/references/动画语法/y2_vox.md"
    },
    {
      "id": "y3",
      "name": "白板手绘解说（RSA Animate 型）",
      "oneLiner": "讲者说一句，手就在一张大白板上写一句、画一个图；相机跟着论证在板上移动，最后拉远，观众看到整场论证是一张图。",
      "card": "docs/reference/huashu/动画语法/y3_whiteboard.md",
      "source": "huashu-art-motion/references/动画语法/y3_whiteboard.md"
    },
    {
      "id": "y4",
      "name": "故事型简笔角色动画（YouTube storytime animation）",
      "oneLiner": "口播是主角，画面是给口播配的「表情包」——角色在几个姿势之间快切（0.1 秒）然后定住，笑点靠切到反应大特写、并在那一下里闭嘴。",
      "card": "docs/reference/huashu/动画语法/y4_storytime.md",
      "source": "huashu-art-motion/references/动画语法/y4_storytime.md"
    },
    {
      "id": "y5",
      "name": "动态文字排版 / 信息图动效（kinetic typography）",
      "oneLiner": "字就是演员——每个关键词踩一个重音砸进来，主词大到一眼读完，其余的字从「槽」里升起给耳朵对位；画面里永远只有一个焦点，镜头和底纹一直在动，字落定后不动。",
      "card": "docs/reference/huashu/动画语法/y5_kinetic_type.md",
      "source": "huashu-art-motion/references/动画语法/y5_kinetic_type.md"
    },
    {
      "id": "y6",
      "name": "讲解员式财经科普",
      "oneLiner": "一个卡通讲解员在纸面、图表和关键词之间串联信息。适合商业史、产品机制和带情绪反应的知识讲解。参考代码在`scripts/engine/reference_films/spacex/spacex_lin/`；这是第9种语法卡，目前没有独立参数化片段，也不附角色sprite。",
      "card": "docs/reference/huashu/动画语法/y6_presenter_explainer.md",
      "source": "huashu-art-motion/references/动画语法/y6_presenter_explainer.md"
    }
  ],
